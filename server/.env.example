# Arcfore API server — copy to server/.env (NEVER commit real values)
# For Vercel: set these as project Environment Variables, never in code.
PORT=8787

# Golf Courses API — https://golfcoursesapi.com (free tier: 30 req/day)
GCA_API_KEY=
GCA_BASE_URL=https://golfcoursesapi.com/api/v1

# OpenAI — https://platform.openai.com/api-keys
# Vision-capable model for frame-based swing analysis; cheaper model for coach text.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.2
OPENAI_COACH_MODEL=gpt-5.4-mini

# Upstash Redis (REST) — REQUIRED for AI endpoints in production. Persistent
# rate limiting + shared course cache across serverless instances.
# Create free DB: https://console.upstash.com → Redis → Create Database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Clerk verification for signed-in users (rate-limit identity only)
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=

# AI budgets / limits (per UTC-ish rolling day)
AI_DAILY_LIMIT_PER_CLIENT=10   # per clientId (Clerk user or device id)
AI_DAILY_LIMIT_PER_IP=30       # per source IP — defends vs. rotated device ids
AI_DAILY_GLOBAL_LIMIT=200      # hard cap on ALL AI calls/day — bounds OpenAI spend
AI_REQUIRE_AUTH=false          # 'true' → AI endpoints need a verified Clerk session

# Upload limits — Vercel caps request bodies at 4.5MB total. Keep
# MAX_FRAME_COUNT x MAX_FRAME_BYTES comfortably under ~4.3MB.
MAX_FRAME_COUNT=16
MAX_FRAME_BYTES=4194304
COURSE_CACHE_TTL_SECONDS=21600

# Optional abuse deterrent — app sends this as x-arcfore-key when set
API_SHARED_SECRET=

# CORS — comma-separated origins, * is fine (native app; browsers need Origin)
CORS_ORIGINS=*
