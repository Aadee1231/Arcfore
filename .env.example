# ============================================================
# Arcfore environment template — copy to .env (NEVER commit it)
# ============================================================

# ---------- Mobile app (Expo public vars — safe to ship in the bundle) ----------

# Backend API base URL. On a physical iPhone, localhost does NOT work:
# use your machine's LAN IP (http://192.168.x.x:8787) or the deployed API domain.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Supabase project (Settings → API in the Supabase dashboard)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# Clerk publishable key (Clerk dashboard → API Keys)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Dev-only: preview dataset on Home/Progress screens (true/false). Never for prod builds.
EXPO_PUBLIC_DEMO_MODE=false

# Dev-only: user id sent as x-dev-user-id to the API when ALLOW_DEV_AUTH=true on the server.
EXPO_PUBLIC_DEV_USER_ID=

# ---------- Backend API server (server/.env — keep secret, never in the app) ----------

PORT=8787

# Supabase service role — bypasses RLS, stays strictly server-side
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# Clerk secret key + issuer (Clerk dashboard → API Keys; issuer = your Clerk domain)
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_ISSUER=https://your-app.clerk.accounts.dev

# Golf Courses API key — https://golfcoursesapi.com (free tier: 30 req/day)
GCA_API_KEY=
GCA_BASE_URL=https://golfcoursesapi.com/api/v1

# Google AI Studio API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_COACH_MODEL=gemini-2.5-flash

# Budgets / limits
AI_DAILY_LIMIT_PER_USER=10
MAX_VIDEO_BYTES=125829120
MAX_VIDEO_SECONDS=120
COURSE_CACHE_TTL_SECONDS=21600

# Dev-only: accept x-dev-user-id header instead of a Clerk JWT. NEVER enable in production.
ALLOW_DEV_AUTH=false

# CORS — comma-separated origins, * for development only
CORS_ORIGINS=*
