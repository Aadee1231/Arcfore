# ============================================================
# Arcfore app env template — copy to .env (NEVER commit it)
# Public values only — all secrets live in server/.env.
# ============================================================

# Backend API base URL. On a physical iPhone, localhost does NOT work:
# use your machine's LAN IP (http://192.168.x.x:8787) or the deployed API domain.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Optional: Clerk publishable key (Clerk dashboard → API Keys).
# Only needed to enable optional sign-in — the app works fully without it.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional: abuse-deterrent token — must match API_SHARED_SECRET in server/.env.
EXPO_PUBLIC_API_TOKEN=

# ---------- Backend API server lives in server/.env ----------
# See server/.env.example — OPENAI_API_KEY and GCA_API_KEY go there, NEVER here.
